{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openardp.example/schema/manifest-0.1.0.json",
  "title": "OpenARDP Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "document_id",
    "version_id",
    "representation_id",
    "source",
    "state",
    "created_at"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^0\\.1\\.[0-9]+$"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "version_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "representation_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "STAGING",
        "READY",
        "FAILED",
        "DELETED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector",
        "locator",
        "media_type",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "connector": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "modified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        }
      }
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
