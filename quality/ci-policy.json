{
  "schema_version": "1.0.0",
  "supported_platforms": [
    "ubuntu-latest",
    "macos-latest",
    "windows-latest"
  ],
  "coverage_owner": "ubuntu-latest",
  "required_checks": [
    "Preflight",
    "Quality (ubuntu-latest)",
    "Quality (macos-latest)",
    "Quality (windows-latest)"
  ],
  "governance_only": {
    "exact": [
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "README.md",
      "SECURITY.md",
      "START_HERE.md",
      "VALIDATION.md"
    ],
    "prefixes": [
      "docs/",
      "spec-kit/feature-prompts/",
      "specs/"
    ]
  },
  "release_owned": {
    "exact": [
      ".github/workflows/release-evidence.yml",
      "pyproject.toml",
      "schemas/openardp-release-evidence.schema.json",
      "uv.lock"
    ],
    "prefixes": [
      "benchmarks/release/",
      "release/",
      "scripts/",
      "src/openardp/domain/",
      "src/openardp/services/",
      "tests/contract/",
      "tests/integration/",
      "tests/security/"
    ]
  },
  "workflow_invariants": {
    "core_workflow": ".github/workflows/ci.yml",
    "release_workflow": ".github/workflows/release-evidence.yml",
    "required_core_markers": [
      "name: CI",
      "types: [opened, synchronize, reopened, ready_for_review, converted_to_draft]",
      "permissions:\n  contents: read",
      "persist-credentials: false",
      "fetch-depth: 0",
      "name: Preflight",
      "name: Quality (ubuntu-latest)",
      "name: Quality (macos-latest)",
      "name: Quality (windows-latest)",
      "github.event.pull_request.draft == false",
      "needs.preflight.outputs.scope == 'full'",
      "python3 scripts/audit_ci.py classify",
      "python scripts/audit_ci.py audit",
      "uv sync --all-extras --locked",
      "uv run --locked pre-commit validate-config",
      "uv run --locked ruff check .",
      "uv run --locked ruff format --check .",
      "uv run --locked mypy src",
      "uv run --locked pytest\n",
      "uv run --locked pytest --no-cov",
      "uv build",
      "enable-cache: true",
      "cache-dependency-glob: uv.lock",
      "uv cache prune --ci",
      "git diff --exit-code"
    ],
    "required_release_markers": [
      "name: Release Evidence",
      "workflow_dispatch:",
      "tags: [\"v*\"]",
      "paths:",
      "github.event.pull_request.draft == false",
      "permissions:\n  contents: read",
      "persist-credentials: false",
      "fail-fast: false",
      "platform: linux",
      "platform: macos",
      "platform: windows",
      "uv sync --extra visual --locked",
      "uv sync --locked",
      "needs: release-evidence",
      "Install uv and Python without downstream cache contention",
      "assert value['status'] == 'NO-GO'",
      "retention-days: 14",
      "enable-cache: true",
      "cache-dependency-glob: uv.lock",
      "uv cache prune --ci"
    ],
    "forbidden_core_markers": [
      "pull_request_target",
      "paths-ignore:",
      "enable-cache: false",
      "release-evidence-${{ matrix.platform }}",
      "Aggregate release gate"
    ],
    "forbidden_release_markers": [
      "pull_request_target",
      "branches: [main]",
      "enable-cache: false"
    ]
  }
}
