{
  "$defs": {
    "BlockKind": {
      "description": "Normalized source-backed block categories.",
      "enum": [
        "title",
        "heading",
        "paragraph",
        "list",
        "list_item",
        "table",
        "code",
        "equation",
        "picture",
        "chart",
        "note",
        "page",
        "slide",
        "other"
      ],
      "title": "BlockKind",
      "type": "string"
    },
    "DataTrustClassification": {
      "additionalProperties": false,
      "description": "Trust metadata for content that must remain non-authoritative data.",
      "properties": {
        "instruction_execution_allowed": {
          "const": false,
          "default": false,
          "title": "Instruction Execution Allowed",
          "type": "boolean"
        },
        "integrity": {
          "$ref": "#/$defs/IntegrityState"
        },
        "role": {
          "const": "data",
          "title": "Role",
          "type": "string"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "zone": {
          "$ref": "#/$defs/TrustZone"
        }
      },
      "required": [
        "zone",
        "role",
        "integrity",
        "sensitivity"
      ],
      "title": "DataTrustClassification",
      "type": "object"
    },
    "IntegrityState": {
      "description": "Integrity evidence available for a record.",
      "enum": [
        "verified_sha256",
        "unverified"
      ],
      "title": "IntegrityState",
      "type": "string"
    },
    "JsonValue": {},
    "Sensitivity": {
      "description": "Sensitivity classification carried with content.",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "unknown"
      ],
      "title": "Sensitivity",
      "type": "string"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "description": "Precise source location treated as data rather than access authority.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        },
        "extraction_method": {
          "minLength": 1,
          "title": "Extraction Method",
          "type": "string"
        },
        "native_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Id"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "slide": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slide"
        }
      },
      "required": [
        "extraction_method"
      ],
      "title": "SourceLocator",
      "type": "object"
    },
    "TrustZone": {
      "description": "Security boundary assigned to content or metadata.",
      "enum": [
        "local_trusted",
        "organization_trusted",
        "external_untrusted",
        "model_derived"
      ],
      "title": "TrustZone",
      "type": "string"
    }
  },
  "$id": "https://openardp.example/schema/block-0.1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    {
      "properties": {
        "structured": {
          "type": [
            "object",
            "array"
          ]
        }
      },
      "required": [
        "structured"
      ]
    },
    {
      "properties": {
        "asset_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "asset_id"
      ]
    }
  ],
  "description": "One canonical content unit pinned to a source representation.",
  "properties": {
    "asset_id": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Id"
    },
    "block_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Block Id",
      "type": "string"
    },
    "canonical_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Canonical Hash",
      "type": "string"
    },
    "document_id": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Document Id",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "kind": {
      "$ref": "#/$defs/BlockKind"
    },
    "order": {
      "title": "Order",
      "type": "integer"
    },
    "parent_id": {
      "anyOf": [
        {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Id"
    },
    "representation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Representation Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceLocator"
    },
    "structured": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Structured"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "trust": {
      "$ref": "#/$defs/DataTrustClassification"
    },
    "version_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "block_id",
    "document_id",
    "version_id",
    "representation_id",
    "kind",
    "order",
    "canonical_hash",
    "source",
    "trust"
  ],
  "title": "OpenARDP Content Block",
  "type": "object",
  "x-openardp-schema-version": "0.1.0"
}
